{
  "name": "grokeries",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build && npx zero-deploy-permissions -p src/zero/zero-schema.ts --output-format=sql --output-file=.permissions.sql",
    "dev": "sst dev -- vite dev",
    "db": "sst shell drizzle-kit",
    "dev:db-down": "docker compose --env-file .env -f ./docker/docker-compose.yml down --volumes",
    "dev:db-up": "docker compose --env-file .env -f ./docker/docker-compose.yml up",
    "dev:zero": "sst dev -- bunx zero-cache-dev -p src/zero/zero-schema.ts --push-url=http:localhost:3000/api/push",
    "start": "vite start",
    "sso": "aws sso login --sso-session gasberg",
    "generate": "sst dev -- drizzle-zero generate --format --output=src/zero/zero-schema.gen.ts",
    "create-migration": "sst dev -- drizzle-kit generate",
    "seed-global-items": "sst dev -- bun run scripts/seed-global-items.ts",
    "import-openfoodfacts": "sst dev -- bun run scripts/import-openfoodfacts.ts",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
