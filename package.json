{
  "name": "grokeries",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "vinxi build",
    "dev": "sst dev -- vinxi dev",
    "db": "sst shell drizzle-kit",
    "dev:db-down": "docker compose --env-file .env -f ./docker/docker-compose.yml down -v",
    "dev:db-up": "docker compose --env-file .env -f ./docker/docker-compose.yml up",
    "zero:server": "npx zero-cache-dev -p zero-schema.ts",
    "start": "vinxi start",
    "sso": "aws sso login --sso-session gasberg",
    "generate": "sst dev -- drizzle-zero generate --format",
    "postinstall": "npm run generate"
  },
  "dependencies": {
    "@rocicorp/zero": "^0.19.2025050203",
    "@tanstack/react-form": "^1.12.0",
    "@tanstack/react-query": "^5.75.0",
    "@tanstack/react-router": "^1.116.0",
    "@tanstack/react-router-devtools": "^1.116.0",
    "@tanstack/react-start": "^1.116.2",
    "@types/pg": "^8.11.14",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.43.1",
    "drizzle-zero": "^0.10.1",
    "nanoid": "^5.1.5",
    "pg": "^8.15.6",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sst": "^3.16.0",
    "vinxi": "0.5.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.8",
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "tailwindcss": "^4.0.8",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
