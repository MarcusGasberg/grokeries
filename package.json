{
  "name": "grokeries",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "sst dev -- vite dev",
    "db": "sst shell drizzle-kit",
    "dev:db-down": "docker compose --env-file .env -f ./docker/docker-compose.yml down --volumes",
    "dev:db-up": "docker compose --env-file .env -f ./docker/docker-compose.yml up",
    "dev:zero": "sst dev -- bunx zero-cache-dev -p src/zero/zero-schema.ts",
    "start": "vite start",
    "sso": "aws sso login --sso-session gasberg",
    "generate": "sst dev -- drizzle-zero generate --format --output=src/zero/zero-schema.gen.ts",
    "create-migration": "sst dev -- drizzle-kit generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@rocicorp/zero": "0.21.2025063000",
    "@tailwindcss/postcss": "^4.1.8",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-query-devtools": "^5.66.0",
    "@tanstack/react-router": "^1.129.0",
    "@tanstack/react-router-devtools": "^1.129.0",
    "@tanstack/react-router-with-query": "^1.129.0",
    "@tanstack/react-start": "^1.129.0",
    "@types/pg": "^8.11.14",
    "better-auth": "^1.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.43.1",
    "drizzle-zero": "^0.10.1",
    "lucide-react": "^0.511.0",
    "nanoid": "^5.1.5",
    "pg": "^8.15.6",
    "postcss": "^8.5.4",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.56.4",
    "redaxios": "^0.5.1",
    "sst": "^3.16.0",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.3.7",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.8",
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.7.2",
    "vite": "^7.0.4",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@rocicorp/zero-sqlite3",
    "@tailwindcss/oxide",
    "aws-sdk",
    "esbuild",
    "protobufjs"
  ]
}
