{
  "name": "grokeries",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "sst dev -- vite dev",
    "db": "sst shell drizzle-kit",
    "dev:db-down": "docker compose --env-file .env -f ./docker/docker-compose.yml down --volumes",
    "dev:db-up": "docker compose --env-file .env -f ./docker/docker-compose.yml up",
    "dev:zero": "sst dev -- bunx zero-cache-dev -p src/zero/zero-schema.ts --push-url=http:localhost:3000/api/push",
    "start": "vite start",
    "sso": "aws sso login --sso-session gasberg",
    "generate": "sst dev -- drizzle-zero generate --format --output=src/zero/zero-schema.gen.ts",
    "create-migration": "sst dev -- drizzle-kit generate",
    "seed-global-items": "sst dev -- bun run scripts/seed-global-items.ts",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.15",
    "@rocicorp/zero": "0.21.2025063000",
    "@tailwindcss/postcss": "^4.1.8",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-query-devtools": "^5.66.0",
    "@tanstack/react-router": "^1.129.0",
    "@tanstack/react-router-devtools": "^1.129.0",
    "@tanstack/react-router-with-query": "^1.129.0",
    "@tanstack/react-start": "^1.129.0",
    "@types/pg": "^8.11.14",
    "better-auth": "^1.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.43.1",
    "drizzle-zero": "^0.10.1",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "lucide-react": "^0.511.0",
    "nanoid": "^5.1.5",
    "pg": "^8.15.6",
    "postcss": "^8.5.4",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-cookie": "^8.0.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.56.4",
    "react-i18next": "^16.0.1",
    "redaxios": "^0.5.1",
    "resend": "^6.1.0",
    "sonner": "^2.0.7",
    "sst": "^3.17.12",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.3.7",
    "zod": "^3.25.42",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.8",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.7.2",
    "vite": "^7.0.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@rocicorp/zero-sqlite3",
    "@tailwindcss/oxide",
    "aws-sdk",
    "esbuild",
    "protobufjs"
  ]
}
